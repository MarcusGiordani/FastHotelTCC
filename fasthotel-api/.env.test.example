# fasthotel-api/.env.test.example
# Modelo para o arquivo .env.test (que NÃO é versionado).
# Copie para .env.test e ajuste as credenciais do seu PostgreSQL local.
#
#   cp .env.test.example .env.test
#
# Regras:
# - PGDATABASE DEVE ser um banco separado do desenvolvimento (fasthotel_test).
#   A suíte de integração se recusa a rodar se PGDATABASE != fasthotel_test.
# - O banco é criado automaticamente (CREATE DATABASE) e populado com
#   database/schema.sql pelo globalSetup do Jest.

PGUSER=postgres
PGHOST=localhost
PGDATABASE=fasthotel_test
PGPASSWORD=sua-senha-local
PGPORT=5432

# Banco de manutenção usado só para executar CREATE DATABASE fasthotel_test.
PGADMIN_DB=postgres

# Qualquer valor serve; é exclusivo dos testes.
JWT_SECRET=integration-tests-only-secret

FRONTEND_URL=http://localhost:3000
